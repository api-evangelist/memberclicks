{
  "opencollection": "1.0.0",
  "info": {
    "name": "MemberClicks MC Professional Attributes Events API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{orgId}.memberclicks.net/oauth/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{orgId}.memberclicks.net/api/v1/event"
          },
          "docs": "Returns the organization's events. MODELED - an Events API resource is documented but its exact path is behind gated documentation."
        },
        {
          "info": {
            "name": "Retrieve an event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{orgId}.memberclicks.net/api/v1/event/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path",
                "description": "The ID of the event."
              }
            ]
          },
          "docs": "Returns a single event by ID. MODELED path."
        }
      ]
    }
  ],
  "bundled": true
}