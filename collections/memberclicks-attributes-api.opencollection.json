{
  "opencollection": "1.0.0",
  "info": {
    "name": "MemberClicks MC Professional Attributes API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://{orgId}.memberclicks.net/oauth/v1/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Attributes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List attributes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{orgId}.memberclicks.net/api/v1/attribute"
          },
          "docs": "Lists the profile attributes (built-in and custom fields)."
        },
        {
          "info": {
            "name": "List attribute selection-set options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{orgId}.memberclicks.net/api/v1/attribute/:attributeId/selection",
            "params": [
              {
                "name": "attributeId",
                "value": "",
                "type": "path",
                "description": "The ID of the attribute."
              }
            ]
          },
          "docs": "Returns the selection-set options available for a custom attribute."
        }
      ]
    }
  ],
  "bundled": true
}